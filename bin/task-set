#!/usr/bin/env bash
# ONLY frontmatter mutator. All other scripts must call this to modify task fields.
# Usage: task-set <task-file> <field> <value>
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib.sh"

usage() {
  echo "usage: task-set <task-file> <field> <value>" >&2
  exit 1
}

[[ $# -lt 3 ]] && usage

FILE="${1}"
FIELD="${2}"
VALUE="${3}"

[[ -f "${FILE}" ]] || { echo "task-set: file not found: ${FILE}" >&2; exit 1; }

# Use python3 to reliably manipulate YAML frontmatter.
python3 - "${FILE}" "${FIELD}" "${VALUE}" <<'EOF'
import sys, re

path, field, value = sys.argv[1], sys.argv[2], sys.argv[3]

with open(path, 'r') as fh:
    content = fh.read()

# Split into frontmatter and body.
parts = content.split('---', 2)
if len(parts) < 3:
    print(f"task-set: no frontmatter in {path}", file=sys.stderr)
    sys.exit(1)

_, fm, body = parts

# Replace or append field.
pattern = re.compile(r'^(' + re.escape(field) + r'):[ \t]*.*$', re.MULTILINE)
replacement = f'{field}: {value}'
if pattern.search(fm):
    fm = pattern.sub(replacement, fm, count=1)
else:
    fm = fm.rstrip('\n') + f'\n{replacement}\n'

with open(path, 'w') as fh:
    fh.write('---' + fm + '---' + body)
EOF
