fleet.config.local.yml
.env
tasks/
scratch/
usage.csv
logs/
.now.lock

# Skills installed from the internet are gitignored by default.
# To ship a project-default skill, add a !-exception line here:
#   !.claude/skills/your-skill-name.md
.claude/skills/*
!.claude/skills/.gitkeep
!.claude/skills/commit.md

# Claude Code agent definitions — gitignored by default.
# To ship a project-default agent, add a !-exception line here:
#   !.claude/agents/your-agent.md
.claude/agents/*
!.claude/agents/.gitkeep

# Persona local overrides — gitignored, never committed.
# config.local.json: merges over config.json (local fields win).
# prompt.local.md:   replaces prompt.md entirely for that persona.
personas/*/config.local.json
personas/*/prompt.local.md

# User-defined personas (complete new or replacement personas).
# To ship a custom persona with the project, put it in personas/ instead.
personas.local/*
!personas.local/.gitkeep

# KB adapters — gitignored by default (user-written, project-specific).
# To ship an adapter with the project, add a !-exception line here:
#   !kb/adapters/your-adapter/
kb/adapters/*
!kb/adapters/.gitkeep

# KB data regenerated by kb-sync — do not commit.
kb/data/*
!kb/data/.gitkeep
kb/INDEX.md

# Agent results — runtime output, do not commit.
results/*
!results/.gitkeep
