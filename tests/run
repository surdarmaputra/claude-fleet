#!/usr/bin/env bash
# Fleet test runner.
# Usage: tests/run [filter]  (filter is a grep pattern on test names)
set -euo pipefail

FLEET_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FILTER="${1:-}"

pass=0
fail=0
skip=0

_TMPDIR=$(mktemp -d)
trap 'rm -rf "${_TMPDIR}"' EXIT

# ── harness ───────────────────────────────────────────────────────────────────

_current_test=""

ok()     { echo "  PASS  ${_current_test}"; (( pass++ )) || true; }
fail()   { echo "  FAIL  ${_current_test}: $*"; (( fail++ )) || true; }
skip_t() { echo "  SKIP  ${_current_test}: $*"; (( skip++ )) || true; }

# Run a named test: run_test "name" cmd args...
# Sets _current_test, runs cmd, calls ok/fail based on exit code.
run_test() {
  _current_test="${1}"; shift
  if [[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}"; then
    return 0
  fi
  if "$@" > /dev/null 2>&1; then
    ok
  else
    fail "exit $?"
  fi
}

# Like run_test but captures combined output for assertion.
run_test_out() {
  _current_test="${1}"; shift
  if [[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}"; then
    return 0
  fi
  _last_out=$("$@" 2>&1) && _last_rc=0 || _last_rc=$?
}

# ── make_fleet_root: temp fleet root with config ──────────────────────────────

make_fleet_root() {
  local d="${_TMPDIR}/${1:-$(date +%s%N)}"
  mkdir -p "${d}/logs" "${d}/tasks" "${d}/results" "${d}/scratch" "${d}/kb/data"
  cp "${FLEET_ROOT}/fleet.config.yml" "${d}/fleet.config.yml"
  echo "${d}"
}

make_task() {
  local dir="${1}" id="${2}" status="${3:-todo}" priority="${4:-normal}" attempts="${5:-}"
  local f="${dir}/tasks/${id}.md"
  cat > "${f}" <<EOF
---
id: ${id}
status: ${status}
persona: default
priority: ${priority}
EOF
  [[ -n "${attempts}" ]] && echo "attempts: ${attempts}" >> "${f}"
  cat >> "${f}" <<EOF
---
Do something for task ${id}.
EOF
}

# ── lib.sh: config_get ────────────────────────────────────────────────────────

echo ""
echo "=== lib.sh: config_get ==="

_current_test="config_get/top-level scalar"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  got=$(FLEET_ROOT="${FLEET_ROOT}" bash -c 'source "'"${FLEET_ROOT}"'/bin/lib.sh" && config_get max_agents 0')
  [[ "${got}" == "3" ]] && ok || fail "got [${got}]"
}

_current_test="config_get/top-level default"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  got=$(FLEET_ROOT="${FLEET_ROOT}" bash -c 'source "'"${FLEET_ROOT}"'/bin/lib.sh" && config_get nonexistent_key fallback')
  [[ "${got}" == "fallback" ]] && ok || fail "got [${got}]"
}

_current_test="config_get/nested cron preserves spaces"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  got=$(FLEET_ROOT="${FLEET_ROOT}" bash -c 'source "'"${FLEET_ROOT}"'/bin/lib.sh" && config_get schedule.spawn MISSING')
  fields=$(echo "${got}" | wc -w | tr -d ' ')
  [[ "${fields}" == "5" ]] && ok || fail "[${got}] → ${fields} fields, want 5"
}

_current_test="config_get/all cron schedules valid"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  all_ok=1
  for key in schedule.spawn schedule.guard schedule.intake schedule.kb_sync; do
    val=$(FLEET_ROOT="${FLEET_ROOT}" bash -c "source '${FLEET_ROOT}/bin/lib.sh' && config_get ${key}")
    fields=$(echo "${val}" | wc -w | tr -d ' ')
    [[ "${fields}" == "5" ]] || { echo "  FAIL ${key}: [${val}]"; all_ok=0; }
  done
  [[ "${all_ok}" -eq 1 ]] && ok || fail "one or more cron schedules invalid"
}

_current_test="config_get/local override wins"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "cfg-local")
  echo "max_agents: 99" > "${d}/fleet.config.local.yml"
  got=$(FLEET_ROOT="${d}" bash -c 'source "'"${FLEET_ROOT}"'/bin/lib.sh" && config_get max_agents 0')
  [[ "${got}" == "99" ]] && ok || fail "got [${got}]"
}

_current_test="config_get/quoted yaml value strips quotes"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "cfg-quotes")
  cat > "${d}/fleet.config.yml" <<'EOF'
schedule:
  spawn: "*/5 9-18 * * 1-5"
EOF
  got=$(FLEET_ROOT="${d}" bash -c 'source "'"${FLEET_ROOT}"'/bin/lib.sh" && config_get schedule.spawn')
  [[ "${got}" == "*/5 9-18 * * 1-5" ]] && ok || fail "got [${got}]"
}

# ── lib.sh: task_get ─────────────────────────────────────────────────────────

echo ""
echo "=== lib.sh: task_get ==="

_current_test="task_get/reads status"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "tg-status")
  make_task "${d}" "abc" "todo"
  got=$(FLEET_ROOT="${d}" bash -c 'source "'"${FLEET_ROOT}"'/bin/lib.sh" && task_get "'"${d}"'/tasks/abc.md" status')
  [[ "${got}" == "todo" ]] && ok || fail "got [${got}]"
}

_current_test="task_get/reads id"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "tg-id")
  make_task "${d}" "my-task-99"
  got=$(FLEET_ROOT="${d}" bash -c 'source "'"${FLEET_ROOT}"'/bin/lib.sh" && task_get "'"${d}"'/tasks/my-task-99.md" id')
  [[ "${got}" == "my-task-99" ]] && ok || fail "got [${got}]"
}

_current_test="task_get/missing field returns empty"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "tg-missing")
  make_task "${d}" "x"
  got=$(FLEET_ROOT="${d}" bash -c 'source "'"${FLEET_ROOT}"'/bin/lib.sh" && task_get "'"${d}"'/tasks/x.md" nonexistent')
  [[ -z "${got}" ]] && ok || fail "got [${got}], want empty"
}

# ── lib.sh: now_ts ───────────────────────────────────────────────────────────

echo ""
echo "=== lib.sh: now_ts ==="

_current_test="now_ts/format is RFC3339"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  ts=$(FLEET_ROOT="${FLEET_ROOT}" bash -c 'source "'"${FLEET_ROOT}"'/bin/lib.sh" && now_ts')
  echo "${ts}" | grep -qE "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" \
    && ok || fail "bad format: [${ts}]"
}

# ── task-set ─────────────────────────────────────────────────────────────────

echo ""
echo "=== task-set ==="

_current_test="task-set/updates existing field"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "ts-update")
  make_task "${d}" "t1" "todo"
  FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/task-set" "${d}/tasks/t1.md" status doing
  got=$(FLEET_ROOT="${d}" bash -c 'source "'"${FLEET_ROOT}"'/bin/lib.sh" && task_get "'"${d}"'/tasks/t1.md" status')
  [[ "${got}" == "doing" ]] && ok || fail "got [${got}]"
}

_current_test="task-set/adds missing field"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "ts-add")
  make_task "${d}" "t2"
  FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/task-set" "${d}/tasks/t2.md" attempts 1
  got=$(FLEET_ROOT="${d}" bash -c 'source "'"${FLEET_ROOT}"'/bin/lib.sh" && task_get "'"${d}"'/tasks/t2.md" attempts')
  [[ "${got}" == "1" ]] && ok || fail "got [${got}]"
}

_current_test="task-set/preserves body"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "ts-body")
  cat > "${d}/tasks/t3.md" <<'TASKEOF'
---
id: t3
status: todo
---
My task body.
Second line.
TASKEOF
  FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/task-set" "${d}/tasks/t3.md" status done
  # awk: skip the two --- delimiters, print everything after the second one
  body=$(awk '/^---$/{n++; next} n>=2{print}' "${d}/tasks/t3.md")
  echo "${body}" | grep -q "My task body." && ok || fail "body was lost"
}

_current_test="task-set/error on missing file"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "ts-missing")
  out=$(FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/task-set" "${d}/nonexistent.md" status done 2>&1 || true)
  echo "${out}" | grep -q "not found" && ok || fail "expected 'not found' in: [${out}]"
}

_current_test="task-set/error on missing args"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  out=$("${FLEET_ROOT}/bin/task-set" 2>&1 || true)
  echo "${out}" | grep -q "usage" && ok || fail "expected 'usage' in: [${out}]"
}

# ── fleet CLI smoke tests ─────────────────────────────────────────────────────

echo ""
echo "=== fleet CLI ==="

_current_test="fleet/no args prints usage"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  out=$("${FLEET_ROOT}/bin/fleet" 2>&1 || true)
  echo "${out}" | grep -q "usage:" && ok || fail "[${out}]"
}

_current_test="fleet/unknown command exits nonzero"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  FLEET_ROOT="${FLEET_ROOT}" "${FLEET_ROOT}/bin/fleet" notacommand 2>/dev/null && fail "expected nonzero exit" || ok
}

_current_test="fleet/tasks empty"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "fl-tasks-empty")
  out=$(FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/fleet" tasks 2>&1)
  echo "${out}" | grep -q "no tasks" && ok || fail "[${out}]"
}

_current_test="fleet/tasks lists todo task"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "fl-tasks-list")
  make_task "${d}" "abc"
  out=$(FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/fleet" tasks 2>&1)
  echo "${out}" | grep -q "abc" && ok || fail "[${out}]"
}

_current_test="fleet/tasks --status filter"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "fl-tasks-filter")
  make_task "${d}" "t1" "done"
  make_task "${d}" "t2" "todo"
  make_task "${d}" "t3" "todo"
  out=$(FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/fleet" tasks --status done 2>&1)
  echo "${out}" | grep -q "t1" \
    && ! echo "${out}" | grep -qE "\bt2\b|\bt3\b" \
    && ok || fail "[${out}]"
}

_current_test="fleet/agents no sessions"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  out=$(FLEET_ROOT="${FLEET_ROOT}" "${FLEET_ROOT}/bin/fleet" agents 2>&1)
  echo "${out}" | grep -qiE "no agent|running agents" && ok || fail "[${out}]"
}

_current_test="fleet/logs no log yet"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "fl-logs")
  out=$(FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/fleet" logs 2>&1)
  echo "${out}" | grep -q "no log yet" && ok || fail "[${out}]"
}

_current_test="fleet/budget unset"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "fl-budget")
  out=$(FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/fleet" budget 2>&1)
  echo "${out}" | grep -qi "budget\|session" && ok || fail "[${out}]"
}

_current_test="fleet/doctor runs"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "fl-doctor")
  out=$(FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/fleet" doctor 2>&1 || true)
  echo "${out}" | grep -qi "doctor" && ok || fail "[${out}]"
}

_current_test="fleet/cron output"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  out=$(FLEET_ROOT="${FLEET_ROOT}" "${FLEET_ROOT}/bin/fleet" cron 2>&1)
  echo "${out}" | grep -qi "schedule\|cron\|launchd" && ok || fail "[${out}]"
}

# ── guard ────────────────────────────────────────────────────────────────────

echo ""
echo "=== guard ==="

_current_test="guard/exit 0 with no tasks"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "gd-empty")
  FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/guard" && ok || fail "exit $?"
}

_current_test="guard/resets orphaned doing task to todo"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "gd-orphan")
  make_task "${d}" "orphan" "doing"
  FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/guard" || true
  got=$(FLEET_ROOT="${d}" bash -c 'source "'"${FLEET_ROOT}"'/bin/lib.sh" && task_get "'"${d}"'/tasks/orphan.md" status')
  [[ "${got}" == "todo" ]] && ok || fail "status=[${got}]"
}

_current_test="guard/blocks task after 3 failed attempts"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "gd-blocked")
  make_task "${d}" "stubborn" "doing" "normal" "3"
  FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/guard" || true
  got=$(FLEET_ROOT="${d}" bash -c 'source "'"${FLEET_ROOT}"'/bin/lib.sh" && task_get "'"${d}"'/tasks/stubborn.md" status')
  [[ "${got}" == "blocked" ]] && ok || fail "status=[${got}]"
}

_current_test="guard/increments attempts on orphan"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "gd-attempts")
  make_task "${d}" "retried" "doing"
  FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/guard" || true
  got=$(FLEET_ROOT="${d}" bash -c 'source "'"${FLEET_ROOT}"'/bin/lib.sh" && task_get "'"${d}"'/tasks/retried.md" attempts')
  [[ "${got}" == "1" ]] && ok || fail "attempts=[${got}]"
}

# ── spawn ────────────────────────────────────────────────────────────────────

echo ""
echo "=== spawn ==="

_current_test="spawn/exit 0 with no tasks"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "sp-empty")
  FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/spawn" && ok || fail "exit $?"
}

_current_test="spawn/skips unknown persona"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "sp-persona")
  make_task "${d}" "t1"
  # override persona to one that doesn't exist
  FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/task-set" "${d}/tasks/t1.md" persona ghost_persona
  out=$(FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/spawn" 2>&1 || true)
  echo "${out}" | grep -q "unknown persona" && ok || fail "[${out}]"
}

_current_test="spawn/skips high-priority tasks before normal"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "sp-priority")
  make_task "${d}" "lo" "todo" "normal"
  make_task "${d}" "hi" "todo" "high"
  # Just verify spawn reads tasks without crashing (no real claude binary)
  FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/spawn" 2>/dev/null || true
  ok
}

# ── now (debounce) ────────────────────────────────────────────────────────────

echo ""
echo "=== now ==="

_current_test="now/debounces repeated calls within window"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "now-debounce")
  # Write a lock timestamp 5 seconds ago — within the 30s debounce window
  echo $(( $(date -u +%s) - 5 )) > "${d}/.now.lock"
  out=$(FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/now" 2>&1 || true)
  echo "${out}" | grep -q "debounced" && ok || fail "[${out}]"
}

_current_test="now/passes through after window expires"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "now-pass")
  # Write a lock timestamp 60 seconds ago — outside the 30s window
  echo $(( $(date -u +%s) - 60 )) > "${d}/.now.lock"
  # spawn will run but exit 0 (no tasks) — we just need no "debounced" message
  out=$(FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/now" 2>&1 || true)
  echo "${out}" | grep -q "debounced" && fail "should not debounce" || ok
}

# ── report ────────────────────────────────────────────────────────────────────

echo ""
echo "=== report ==="

_current_test="report/no csv prints message"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "rp-empty")
  out=$(FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/report" 2>&1)
  echo "${out}" | grep -qi "no usage" && ok || fail "[${out}]"
}

_current_test="report/parses csv by persona"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  d=$(make_fleet_root "rp-parse")
  cat > "${d}/usage.csv" <<'CSV'
timestamp,task_id,persona,input_tokens,output_tokens,cache_hit_tokens
2026-01-01T10:00:00Z,task-1,default,1000,200,50
2026-01-01T11:00:00Z,task-2,default,500,100,0
CSV
  out=$(FLEET_ROOT="${d}" "${FLEET_ROOT}/bin/report" 2>&1)
  echo "${out}" | grep -q "default" && ok || fail "[${out}]"
}

_current_test="report/unknown option exits 1"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  FLEET_ROOT="${FLEET_ROOT}" "${FLEET_ROOT}/bin/report" --bad-opt 2>/dev/null \
    && fail "expected nonzero exit" || ok
}

# ── install: cron content validation ─────────────────────────────────────────

echo ""
echo "=== install: cron generation ==="

_current_test="install/cron lines have 5 schedule fields"
[[ -n "${FILTER}" ]] && ! echo "${_current_test}" | grep -qE "${FILTER}" || {
  all_ok=1
  for key in schedule.spawn schedule.guard schedule.intake schedule.kb_sync; do
    sched=$(FLEET_ROOT="${FLEET_ROOT}" bash -c "source '${FLEET_ROOT}/bin/lib.sh' && config_get ${key}")
    fields=$(echo "${sched}" | wc -w | tr -d ' ')
    [[ "${fields}" == "5" ]] || { all_ok=0; echo "  bad field count for ${key}: [${sched}]"; }
    first=$(echo "${sched}" | awk '{print $1}')
    echo "${first}" | grep -qE "^[0-9*/,-]+$" || { all_ok=0; echo "  bad minute field for ${key}: [${first}]"; }
  done
  [[ "${all_ok}" -eq 1 ]] && ok || fail "one or more cron schedules malformed"
}

# ── summary ───────────────────────────────────────────────────────────────────

echo ""
total=$(( pass + fail + skip ))
echo "=== results: ${pass} passed, ${fail} failed, ${skip} skipped / ${total} total ==="
echo ""
[[ "${fail}" -eq 0 ]] || exit 1
